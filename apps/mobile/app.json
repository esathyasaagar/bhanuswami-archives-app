{
  "expo": {
    "name": "Bhanu Swami Archives",
    "slug": "bhanuswami-archives",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bhanuswami",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a0a00"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.bhanuswamiarchives.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a0a00"
      },
      "package": "net.bhanuswamiarchives.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3645caac-a4db-49f2-b64d-61911bb64035"
      }
    },
    "plugins": [
      "expo-router",
      "expo-av",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#8b1a1a"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "sathyasaagar"
  }
}
